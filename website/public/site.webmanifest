{
  "name": "Gmail Notifier for KDE",
  "short_name": "Gmail Notifier",
  "description": "Lightweight system tray email notifier for KDE on Linux",
  "start_url": "/",
  "display": "browser",
  "background_color": "#2b2d30",
  "theme_color": "#2a2d31",
  "icons": [
    {
      "src": "/favicon-32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ]
}
